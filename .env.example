# ==============================================================================
# SpeakMate Environment Variables
# ==============================================================================

# SUPABASE CLIENT CONFIGURATION (Public Frontend)
# Your Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase Anon/Publishable API Key (Safe to expose in browser)
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-key"

# METERED OPEN RELAY TURN CONFIGURATION (Backend Private Secrets)
# Never exposed in frontend code; fetched securely via /api/ice-servers
# Leave empty to use the official free Metered Open Relay project credentials,
# or enter your API key from https://www.metered.ca/dashboard
METERED_API_KEY=""
METERED_DOMAIN="openrelay.metered.ca"

# WEBRTC STUN SERVER CONFIGURATION (Default public Google STUN servers)
VITE_STUN_SERVER="stun:stun.l.google.com:19302"

# HOSTING & URL
PORT=3000
APP_URL="http://localhost:3000"
